#!/usr/bin/env bash
#
# Generate a QR code image from text and open it.
# Usage: qr https://example.com
#
set -euo pipefail

if [[ $# -eq 0 ]]; then
    echo "Usage: qr <text or URL>" >&2
    exit 1
fi

timestamp=$(date '+%Y%m%dT%H%M%S')
file="/tmp/qr-${timestamp}.png"

qrencode -s 12 -o "$file" "$*"
xdg-open "$file"
